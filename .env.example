# Copy to .env on the server and fill in. Never commit .env.

# Long random string, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=

# CoinGecko Demo (free) plan key from https://www.coingecko.com/en/api/pricing
# Optional, but without it the shared public rate limit applies.
COINGECKO_API_KEY=

# Public URL, used for canonical links and the sitemap.
SITE_URL=https://midbig.com

# Hostnames Caddy serves and fetches TLS certificates for.
SITE_ADDRESS=midbig.com, www.midbig.com

# Signs login cookies. Required for a public launch: a long random string,
# e.g. from: openssl rand -hex 32
# On a home computer it can stay empty (one is derived from POSTGRES_PASSWORD).
BETTER_AUTH_SECRET=

# Optional. Sends password reset and price alert emails through Resend
# (https://resend.com, free for 3,000 emails a month). Without it, reset links
# are printed in the web log and alerts only go out as notifications.
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
EMAIL_FROM=midbig <alerts@midbig.com>

# Optional "Continue with Google" button. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with the redirect URL
# https://midbig.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your own account's email (comma separate several). These accounts become
# admins: they see /mod, can approve or remove chat messages, ban people and
# make other accounts moderators. Turn on two-factor login on the account page
# first; moderator tools stay locked without it.
ADMIN_EMAILS=

# Optional bot check on sign-up and on each member's first chat message.
# Free: Cloudflare dashboard > Turnstile > Add widget, with your site's domain.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
