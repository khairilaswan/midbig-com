{
  "name": "midbig",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:prices": "pnpm --filter @midbig/prices dev",
    "dev:web": "pnpm --filter @midbig/web dev",
    "dev:mock": "pnpm --filter @midbig/prices mock"
  }
}
